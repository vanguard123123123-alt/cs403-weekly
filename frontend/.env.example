# Copy this file to .env (or .env.production for a production build) and adjust
# the value. Vite loads this automatically at build time — see README/Vite docs.
#
# NOTE: Vite inlines this value into the built JS at build time, not at container
# runtime. Changing it after the app is built requires rebuilding.

VITE_API_URL=http://localhost:8080
