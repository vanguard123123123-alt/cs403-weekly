# Reference list of environment variables this backend reads (see application.properties).
#
# IMPORTANT: Spring Boot does NOT load a .env file automatically. These variables
# must be supplied by whatever runs the app (Docker `--env-file`, docker-compose
# `env_file:`, systemd `EnvironmentFile=`, your CI/host's secret manager, etc.).
# This file only documents what to set — copying it to `.env` has no effect by itself.
#
# Any variable left unset falls back to the local-dev default baked into
# application.properties, which is why `./mvnw spring-boot:run` works with none of this set.

DB_URL=jdbc:mysql://localhost:3306/cs403_weekly_summary?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_db_password_here

JWT_SECRET=generate_with_openssl_rand_base64_48
OPENAI_API_KEY=your_openai_api_key_here

# Absolute path on the deployment host where uploaded files should be stored.
FILE_UPLOAD_DIR=/var/app/uploads

# Comma-separated list of frontend origins allowed to call this API.
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.example
