spring.application.name=backend

# All values below can be overridden by an environment variable of the same name
# (e.g. DB_PASSWORD, JWT_SECRET) for deployment; the part after ":" is only the
# local-dev fallback used when that variable isn't set.
spring.datasource.url=${DB_URL:jdbc:mysql://localhost:3306/cs403_weekly_summary?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true}
spring.datasource.username=${DB_USERNAME:root}
spring.datasource.password=${DB_PASSWORD:your_password_here}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect

# Generate your own secret, e.g.: openssl rand -base64 48
jwt.secret=${JWT_SECRET:change_this_to_a_long_random_secret}
jwt.expiration-ms=86400000
openai.api.key=${OPENAI_API_KEY:your_openai_api_key_here}

file.upload-dir=${FILE_UPLOAD_DIR:uploads}
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB

summary.daily-limit=10
summary.max-input-chars=30000
summary.max-pages=25
summary.vision-max-pages=8
summary.vision-daily-limit=10

cors.allowed-origins=${CORS_ALLOWED_ORIGINS:http://localhost:5173}